{
  "version": 1,
  "sources": {
    "orders": { "format": "csv", "path": "orders.csv" },
    "customers": { "format": "csv", "path": "customers.csv" }
  },
  "plan": {
    "op": "limit",
    "n": 5,
    "input": {
      "op": "sort",
      "keys": [{ "column": "revenue", "desc": true }],
      "input": {
        "op": "aggregate",
        "keys": ["segment"],
        "aggs": [
          { "func": "sum", "input": "amount", "as": "revenue" },
          { "func": "count", "input": "order_id", "as": "orders" }
        ],
        "input": {
          "op": "join",
          "kind": "inner",
          "left": {
            "op": "filter",
            "predicate": {
              "op": ">",
              "left": { "col": "amount" },
              "right": { "lit": 10 }
            },
            "input": { "op": "scan", "source": "orders" }
          },
          "right": { "op": "scan", "source": "customers" },
          "left_keys": ["customer", "tenant"],
          "right_keys": ["customer", "tenant"]
        }
      }
    }
  },
  "contracts": [
    { "kind": "row_count", "min": 1, "max": 5 },
    { "kind": "unique", "columns": ["segment"] },
    { "kind": "no_null", "columns": ["segment", "revenue"] }
  ]
}
