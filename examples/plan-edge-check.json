{
  "version": 1,
  "sources": {
    "orders": { "format": "csv", "path": "orders.csv" }
  },
  "plan": {
    "op": "filter",
    "predicate": {
      "op": ">",
      "left": { "col": "amount" },
      "right": { "lit": 10 }
    },
    "input": { "op": "scan", "source": "orders" }
  },
  "contracts": [
    { "kind": "row_count", "min": 1, "max": 10 },
    { "kind": "unique", "columns": ["order_id"] },
    { "kind": "no_null", "columns": ["customer", "qty"] }
  ]
}
